// Auto-generated from dict/*.md — Content/ContentClass knowledge graph.
// Compatible with Neo4j and Memgraph.

CREATE CONSTRAINT content_id IF NOT EXISTS FOR (n:Content) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT content_class_id IF NOT EXISTS FOR (n:ContentClass) REQUIRE n.id IS UNIQUE;

MERGE (k:ContentClass {id: "class:artifact"}) SET k.name = "Artifact", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:component"}) SET k.name = "Component", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:concept"}) SET k.name = "Concept", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:mechanism"}) SET k.name = "Mechanism", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:principle"}) SET k.name = "Principle", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:protocol"}) SET k.name = "Protocol", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:research"}) SET k.name = "Research", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:technology"}) SET k.name = "Technology", k.file = "dict/00_content_classes.md";
MERGE (k:ContentClass {id: "class:threat"}) SET k.name = "Threat", k.file = "dict/00_content_classes.md";

MERGE (c:Content {id: "content:_skip_modules"}) SET c.name = "_SKIP_MODULES", c.file = "dict/02_tools_and_skills.md", c.description = "Tool Discovery에서 제외되는 모듈 이름 목록: `base`, `schema`, `registry`, `context`, `loader`, `config`, `file_state`, `sandbox`, `mcp`, `runtime_state` 등. 도구가 아닌 인프라이거나(Sandbox), 특수 경로로 등록되는 (MCPToolWrapper) 모듈들입니다 — 자동 발견의 \"예외 명단\".";
MERGE (c:Content {id: "content:adapter-pattern"}) SET c.name = "Adapter Pattern", c.file = "dict/01_core_architecture.md", c.description = "호환되지 않는 인터페이스를 가진 외부 시스템을, 내가 원하는 표준 인터페이스로 변환해 끼우는 패턴 (GoF 디자인 패턴). 외부의 다양성을 경계에서 흡수하고 내부는 단일 형태만 다루게 합니다.";
MERGE (c:Content {id: "content:agent"}) SET c.name = "Agent", c.file = "dict/01_core_architecture.md", c.description = "LLM이 Tool을 호출하며 목표를 향해 여러 단계를 스스로 수행하는 소프트웨어. 단순 챗봇이 \"질문 → 한 번의 답변\"으로 끝난다면, 에이전트는 \"관찰 → 판단 → 행동 → 결과 확인\"의 에이전트 루프를 목표 달성까지 반복합니다.";
MERGE (c:Content {id: "content:agent-loop-concept"}) SET c.name = "Agent Loop (concept)", c.file = "dict/08_ai_llm_concepts.md", c.description = "\"모델 호출 → 행동 → 관찰 → 재호출\"을 목표 달성까지 반복하는 일반 패턴 — ReAct가 이 패턴의 이론적 뿌리입니다. nanobot의 AgentLoop/AgentRunner는 이 일반 개념의 구현(더 특수한 형태)입니다.";
MERGE (c:Content {id: "content:agent-skills"}) SET c.name = "Agent Skills", c.file = "dict/08_ai_llm_concepts.md", c.description = "Anthropic이 정리한 스킬 규격 — 폴더 + SKILL.md (Frontmatter 메타데이터 + 본문 절차)로 에이전트 노하우를 패키징합니다. nanobot의 스킬 형식이 이 계열입니다.";
MERGE (c:Content {id: "content:agentloop"}) SET c.name = "AgentLoop", c.file = "dict/01_core_architecture.md", c.description = "메시지 단위의 바깥 턴 State Machine. MessageBus에서 InboundMessage를 소비해 Session Key를 결정하고, Context를 구축한 뒤 AgentRunner에게 실행을 맡기고, 결과를 OutboundMessage로 발행합니다.";
MERGE (c:Content {id: "content:agentrunner"}) SET c.name = "AgentRunner", c.file = "dict/01_core_architecture.md", c.description = "한 Turn 안에서 \"Provider 호출 → Tool 실행 → 결과 반영 → 재호출\"을 반복하는 안쪽 루프. Streaming 델타 처리, 반복 상한, Injection 처리를 담당합니다. AgentLoop가 \"무엇을 보여줄지\"를 준비한다면, 러너는 \"모델과의 실제 대화\"를 굴립니다.";
MERGE (c:Content {id: "content:anthropic-provider"}) SET c.name = "Anthropic Provider", c.file = "dict/04_providers_and_llm.md", c.description = "Claude 모델용 프로바이더. Anthropic Messages API 특유의 형식(별도 system 파라미터, content block 배열)을 공통 인터페이스로 변환합니다.";
MERGE (c:Content {id: "content:api-server"}) SET c.name = "API Server", c.file = "dict/05_channels_gateway_ui.md", c.description = "OpenAI-Compatible API(`/v1/chat/completions`, `/v1/models`)를 노출하는 HTTP 서버. 외부 프로그램이 nanobot 에이전트를 \"그냥 OpenAI 모델인 것처럼\" 호출할 수 있게 합니다.";
MERGE (c:Content {id: "content:append-only-log"}) SET c.name = "Append-only Log", c.file = "dict/03_memory_context_session.md", c.description = "기존 내용을 수정하지 않고 끝에 덧붙이기만 하는 저장 방식. 쓰기가 빠르고, 동시 접근 충돌이 적고, 과거가 변조되지 않으며, 크래시 시 피해가 마지막 항목으로 국한됩니다. 데이터베이스의 WAL, 블록체인, 이벤트 소싱이 모두 이 원리입니다.";
MERGE (c:Content {id: "content:apply_patch"}) SET c.name = "apply_patch", c.file = "dict/02_tools_and_skills.md", c.description = "여러 파일 변경을 하나의 패치 텍스트로 기술해 원자적으로 적용하는 편집 도구. \"3개 파일을 고치다가 2번째에서 실패\"하는 어중간한 상태 대신, 전부 성공 또는 전부 실패를 보장하는 방향의 설계입니다.";
MERGE (c:Content {id: "content:apps"}) SET c.name = "Apps", c.file = "dict/05_channels_gateway_ui.md", c.description = "에이전트 위에 얹는 응용 기능 모음(캔버스 등). \"Core stays small\" 원칙에 따라 코어 밖 가장자리에 위치합니다.";
MERGE (c:Content {id: "content:asyncio"}) SET c.name = "asyncio", c.file = "dict/09_dev_stack.md", c.description = "파이썬 표준 비동기 프레임워크 — 단일 스레드의 Event Loop가 I/O 대기 중인 Coroutine들을 갈아타며 동시성을 냅니다. nanobot의 작업(LLM API 대기, 채널 폴링, 크론 대기)은 대부분 I/O 대기라 이 모델에 이상적입니다. 저장소 규칙: \"asyncio throughout\".";
MERGE (c:Content {id: "content:asyncioqueue"}) SET c.name = "asyncio.Queue", c.file = "dict/09_dev_stack.md", c.description = "Coroutine 간 안전한 전달 통로가 되는 비동기 큐 — `await get()`은 항목이 올 때까지 양보하며 기다립니다. MessageBus의 구현 재료입니다.";
MERGE (c:Content {id: "content:atomic-write"}) SET c.name = "Atomic Write", c.file = "dict/03_memory_context_session.md", c.description = "파일 쓰기가 \"전부 반영\" 또는 \"전혀 반영 안 됨\" 둘 중 하나가 되도록 하는 기법 — 임시 파일에 쓰고 fsync 후 원자적 rename으로 교체하는 것이 정석입니다. 도중에 전원이 나가도 반쯤 쓰인 파일이 남지 않습니다. nanobot의 메모리 저장이 이 방식을 씁니다(fsync 포함).";
MERGE (c:Content {id: "content:autocompact"}) SET c.name = "AutoCompact", c.file = "dict/03_memory_context_session.md", c.description = "유휴(idle) 세션의 긴 이력을 배경에서 Consolidation으로 요약하는 서비스. 사용자가 대화 중일 때가 아니라 한가할 때 정리하므로 응답 지연이 없습니다. 최근 8개 메시지(`_RECENT_SUFFIX_MESSAGES`)는 원문 유지 — Sliding Window의 앵커입니다.";
MERGE (c:Content {id: "content:automation-turns"}) SET c.name = "Automation Turns", c.file = "dict/06_scheduling_automation.md", c.description = "크론 외 자동화(트리거 등)로 시작된 턴의 공통 처리 — 표시 이름, 이력 규칙 등.";
MERGE (c:Content {id: "content:azure-openai-provider"}) SET c.name = "Azure OpenAI Provider", c.file = "dict/04_providers_and_llm.md", c.description = "Azure에 배포된 OpenAI 모델용 프로바이더(배포 이름, API 버전 등 Azure 특유 설정 처리). `azure` Optional Dependencies로 설치됩니다.";
MERGE (c:Content {id: "content:bedrock-provider"}) SET c.name = "Bedrock Provider", c.file = "dict/04_providers_and_llm.md", c.description = "AWS Bedrock을 통해 모델을 호출하는 프로바이더 — API 키 대신 AWS 자격증명(IAM) 체계를 씁니다.";
MERGE (c:Content {id: "content:bootstrap-templates"}) SET c.name = "Bootstrap Templates", c.file = "dict/03_memory_context_session.md", c.description = "새 Workspace를 초기화할 때 복사되는 시드 파일들 (SOUL.md, HEARTBEAT.md의 원형). `utils/prompt_templates.py`가 로드합니다 — \"새 에이전트의 출고 시 성격\".";
MERGE (c:Content {id: "content:bound-runner"}) SET c.name = "Bound Runner", c.file = "dict/06_scheduling_automation.md", c.description = "크론 실행을 특정 세션/채널에 바인딩된 에이전트 턴으로 바꿔 주는 실행기. \"예약 작업도 결국 하나의 Turn\"으로 수렴시켜, 크론용 별도 실행 경로를 만들지 않습니다.";
MERGE (c:Content {id: "content:bpe"}) SET c.name = "BPE", c.file = "dict/08_ai_llm_concepts.md", c.description = "자주 함께 등장하는 문자 쌍을 반복 병합해 어휘를 만드는 Tokenizer 알고리즘 (Sennrich et al., 2016에서 신경망 번역에 도입). 희귀 단어도 조각으로 분해해 표현할 수 있어 \"모르는 단어\" 문제가 사라집니다.";
MERGE (c:Content {id: "content:bubblewrap"}) SET c.name = "bubblewrap", c.file = "dict/07_security_isolation.md", c.description = "Linux Namespaces를 이용하는 경량 샌드박스 도구(Flatpak 프로젝트 산하). 루트 권한 없이 파일시스템 뷰·네트워크·프로세스를 격리한 채 명령 하나를 실행할 수 있어, 컨테이너보다 가볍게 \"명령 단위 격리\"가 가능합니다. nanobot의 리눅스 기본 백엔드입니다.";
MERGE (c:Content {id: "content:bun"}) SET c.name = "bun", c.file = "dict/09_dev_stack.md", c.description = "Node.js 호환의 고속 자바스크립트 런타임 겸 패키지 매니저 — WebUI의 설치/빌드/테스트(`bun run build`)에 사용됩니다.";
MERGE (c:Content {id: "content:camelcase-alias"}) SET c.name = "camelCase Alias", c.file = "dict/09_dev_stack.md", c.description = "파이썬 필드는 `snake_case`, JSON 키는 `camelCase`를 쓰는 관행 차이를 Pydantic alias로 흡수하는 설정. `config.json`에서 `maxTokens`라고 써도 파이썬의 `max_tokens`에 매핑됩니다.";
MERGE (c:Content {id: "content:chain-of-thought"}) SET c.name = "Chain-of-Thought", c.file = "dict/08_ai_llm_concepts.md", c.description = "답만 내지 말고 중간 추론 단계를 먼저 출력하게 하면 복잡한 문제의 정답률이 크게 오른다는 발견 (Wei et al., 2022). \"step by step으로 생각해 보자\" 한 줄이 대표적 트리거입니다. ReAct의 Thought 단계, 최신 모델의 내장 추론 (Reasoning Blocks)으로 이어졌습니다.";
MERGE (c:Content {id: "content:channel"}) SET c.name = "Channel", c.file = "dict/01_core_architecture.md", c.description = "외부 메시징 플랫폼과 nanobot을 잇는 Adapter Pattern 구현. 플랫폼 메시지 ↔ InboundMessage/OutboundMessage 변환을 담당합니다. Tool Discovery와 같은 방식(pkgutil 스캔 + Entry-point Plugin)으로 자동 등록됩니다.";
MERGE (c:Content {id: "content:channel-manager"}) SET c.name = "Channel Manager", c.file = "dict/05_channels_gateway_ui.md", c.description = "설정에 활성화된 Channel들을 찾아 생성·시작·정지시키는 조율자. 채널 하나가 죽어도 다른 채널은 계속 돌게 오류를 격리합니다.";
MERGE (c:Content {id: "content:channel-registry"}) SET c.name = "Channel Registry", c.file = "dict/05_channels_gateway_ui.md", c.description = "채널 이름 → 구현 클래스 매핑을 관리하는 Registry Pattern 구현. pkgutil 스캔과 Entry-point Plugin으로 자동 채워집니다 — Tool Discovery와 같은 방식의 채널판입니다.";
MERGE (c:Content {id: "content:circuit-breaker"}) SET c.name = "Circuit Breaker", c.file = "dict/04_providers_and_llm.md", c.description = "연속 실패한 대상을 일정 시간 차단(open) 해 불필요한 재시도와 연쇄 장애를 막는 신뢰성 패턴 (전기 차단기의 비유; Michael Nygard, *Release It!*). 상태는 Closed(정상) → Open(차단) → Half-open(시험 복귀)으로 도는 State Machine입니다.";
MERGE (c:Content {id: "content:command-router"}) SET c.name = "Command Router", c.file = "dict/01_core_architecture.md", c.description = "`/`로 시작하는 Slash Command를 LLM에 보내지 않고 직접 처리하는 라우터. 결정적(deterministic)이어야 하는 조작(세션 초기화 등)을 모델의 변덕에서 분리합니다.";
MERGE (c:Content {id: "content:config"}) SET c.name = "Config", c.file = "dict/01_core_architecture.md", c.description = "`~/.nanobot/config.json`에서 로드되는 Pydantic 기반 설정. JSON 관행을 위한 camelCase Alias를 지원하고, `${VAR}` 패턴은 로드 시 환경변수로 치환됩니다(없으면 `ValueError` — 조용한 오설정 방지).";
MERGE (c:Content {id: "content:consolidation"}) SET c.name = "Consolidation", c.file = "dict/03_memory_context_session.md", c.description = "오래된 대화 구간을 LLM으로 Summarization해 원문 대신 요약본을 유지하는 것.";
MERGE (c:Content {id: "content:container"}) SET c.name = "Container", c.file = "dict/07_security_isolation.md", c.description = "Linux Namespaces + cgroups(자원 제한) + 이미지 레이어로 프로세스를 패키징· 격리하는 기술(Docker, Podman). nanobot에서는 샌드박스 백엔드의 한 선택지입니다 — bubblewrap보다 무겁지만 이미지로 실행 환경까지 통제합니다.";
MERGE (c:Content {id: "content:context"}) SET c.name = "Context", c.file = "dict/03_memory_context_session.md", c.description = "한 번의 LLM 호출에 들어가는 모든 입력의 조립체. 모델은 이 조립체에 든 것만 알 수 있으므로, \"컨텍스트에 무엇을 넣느냐\"가 에이전트의 지능을 좌우합니다. `build_messages()`가 조립합니다.";
MERGE (c:Content {id: "content:context-compression"}) SET c.name = "Context Compression", c.file = "dict/08_ai_llm_concepts.md", c.description = "유한한 Context Window 안에 긴 이력을 담기 위해 정보를 줄이는 기법의 총칭.";
MERGE (c:Content {id: "content:context-governance"}) SET c.name = "Context Governance", c.file = "dict/03_memory_context_session.md", c.description = "모델에 보내기 직전의 메시지 목록을 검증·절단하는 규칙 모음: Input Budget 계산, Orphan Tool Result 제거, `snip_history`로 오래된 이력 절단. \"보내면 API가 거부할 요청\"을 사전에 합법 상태로 고치는 마지막 관문입니다.";
MERGE (c:Content {id: "content:context-window"}) SET c.name = "Context Window", c.file = "dict/08_ai_llm_concepts.md", c.description = "모델이 한 번에 볼 수 있는 Token 수의 상한 — 모델의 \"작업 기억\" 크기. Self-Attention의 제곱 비용이 근본 원인입니다. 이 유한함이 Context Compression, Memory, Progressive Disclosure 등 이 사전의 많은 장치를 낳았습니다.";
MERGE (c:Content {id: "content:contextvar"}) SET c.name = "ContextVar", c.file = "dict/09_dev_stack.md", c.description = "비동기 작업마다 독립된 값을 갖는 변수(표준 `contextvars`). 전역 변수는 동시 실행 중인 여러 턴이 서로 덮어쓰지만, ContextVar는 실행 문맥별로 분리됩니다 — 여러 대화를 동시에 처리하는 nanobot에서 \"지금 이 턴\"의 상태를 안전하게 유지하는 수단입니다.";
MERGE (c:Content {id: "content:coroutine"}) SET c.name = "Coroutine", c.file = "dict/09_dev_stack.md", c.description = "`async def`로 정의되어 `await` 지점에서 스스로 실행을 양보할 수 있는 함수. Event Loop는 양보한 코루틴 대신 준비된 다른 코루틴을 실행합니다 — 협력적 멀티태스킹입니다.";
MERGE (c:Content {id: "content:cron"}) SET c.name = "Cron", c.file = "dict/06_scheduling_automation.md", c.description = "유닉스에서 유래한 시간 기반 작업 스케줄링 개념. Cron Expression이라는 5필드 문자열로 \"언제\"를 표현합니다. nanobot은 OS의 crontab이 아니라 자체 CronService를 Gateway 안에서 돌립니다 — 설치 환경(Windows 포함)과 무관하게 동작하기 위해서입니다.";
MERGE (c:Content {id: "content:cron-expression"}) SET c.name = "Cron Expression", c.file = "dict/06_scheduling_automation.md", c.description = "`분 시 일 월 요일` 5개 필드로 스케줄을 표현하는 문자열 형식.";
MERGE (c:Content {id: "content:cron-job"}) SET c.name = "Cron Job", c.file = "dict/06_scheduling_automation.md", c.description = "등록된 예약 작업 하나 — 스케줄(Cron Expression), 실행할 메시지/프롬프트, 전달 방식 등을 담습니다. 사용자가 직접 등록할 수도, 에이전트가 Cron Tool로 스스로 등록할 수도 있습니다.";
MERGE (c:Content {id: "content:cron-store"}) SET c.name = "Cron Store", c.file = "dict/06_scheduling_automation.md", c.description = "Cron Job 목록이 저장되는 JSON 파일. 재시작해도 예약이 유지되고, 사람이 직접 열어 확인/수정할 수 있습니다.";
MERGE (c:Content {id: "content:cron-tool"}) SET c.name = "Cron Tool", c.file = "dict/02_tools_and_skills.md", c.description = "에이전트가 스스로 Cron Job을 등록/삭제하는 도구.";
MERGE (c:Content {id: "content:cron-turns"}) SET c.name = "Cron Turns", c.file = "dict/06_scheduling_automation.md", c.description = "크론 발 턴의 이력 기록 방식을 다루는 모듈 — 시스템이 만든 턴을 사용자 대화와 구분해 History Visibility 규칙을 적용합니다.";
MERGE (c:Content {id: "content:croniter"}) SET c.name = "croniter", c.file = "dict/06_scheduling_automation.md", c.description = "Cron Expression을 파싱해 \"다음 실행 시각\"을 계산해 주는 파이썬 라이브러리. CronService가 스케줄 계산에 사용합니다.";
MERGE (c:Content {id: "content:cronservice"}) SET c.name = "CronService", c.file = "dict/06_scheduling_automation.md", c.description = "Cron Job 목록을 로드해 시간이 되면 실행하는 스케줄러 서비스. Gateway와 함께 뜨며, 실행은 Bound Runner를 통해 에이전트 턴으로 변환됩니다.";
MERGE (c:Content {id: "content:cursor"}) SET c.name = "Cursor", c.file = "dict/03_memory_context_session.md", c.description = "스트림/로그에서 \"여기까지 처리했다\"를 기록하는 위치 표식. 커서 이후만 처리하면 되므로 재처리와 중복을 막고, 크래시 후에도 이어서 진행할 수 있습니다.";
MERGE (c:Content {id: "content:ddgs"}) SET c.name = "ddgs", c.file = "dict/09_dev_stack.md", c.description = "DuckDuckGo 검색 라이브러리 — API 키 없이 웹 검색을 제공하므로 Web Tools의 기본 검색 백엔드로 적합합니다.";
MERGE (c:Content {id: "content:decoupling"}) SET c.name = "Decoupling", c.file = "dict/01_core_architecture.md", c.description = "구성요소들이 서로의 내부 구현을 모르게 하여, 한쪽의 변경이 다른 쪽에 파급되지 않게 하는 설계 원칙. 중간에 표준화된 인터페이스(큐, 이벤트, 추상 클래스)를 끼워 실현합니다.";
MERGE (c:Content {id: "content:defense-in-depth"}) SET c.name = "Defense in Depth", c.file = "dict/07_security_isolation.md", c.description = "한 겹의 방어에 의존하지 않고 여러 겹을 두는 원칙 — 한 겹이 뚫려도 다음 겹이 막습니다. `.agent/security.md`가 명시하듯 nanobot에서 OS 샌드박스와 애플리케이션 가드는 서로 대체가 아니라 보완 관계입니다.";
MERGE (c:Content {id: "content:delta"}) SET c.name = "Delta", c.file = "dict/04_providers_and_llm.md", c.description = "Streaming에서 도착하는 응답의 증분 조각. 텍스트 델타, 도구 호출 인자 델타 등이 있고, AgentRunner가 이들을 모아 완전한 메시지로 조립합니다.";
MERGE (c:Content {id: "content:dns-pinning"}) SET c.name = "DNS Pinning", c.file = "dict/07_security_isolation.md", c.description = "DNS Rebinding 방어 — 검사 시점에 해석한 IP를 고정(pin) 해 실제 연결도 반드시 그 IP로만 가게 합니다. 검사와 사용 사이의 틈을 없애는 원리입니다.";
MERGE (c:Content {id: "content:dns-rebinding"}) SET c.name = "DNS Rebinding", c.file = "dict/07_security_isolation.md", c.description = "SSRF 차단을 우회하는 기법 — 검사 시점에는 공인 IP를, 실제 접속 시점에는 사설 IP를 돌려주도록 DNS 응답을 바꿔치기합니다. \"검사할 때와 사용할 때가 다르다\"는 TOCTOU 문제의 네트워크판입니다.";
MERGE (c:Content {id: "content:dream"}) SET c.name = "Dream", c.file = "dict/03_memory_context_session.md", c.description = "Cron으로 주기 실행되는 기억 통합 작업 — 사람이 자면서 기억을 정리하는 것의 비유입니다. history.jsonl의 미처리 기록과 현재 메모리 파일 내용을 프롬프트로 만들어, 파일 편집 도구만 가진 제한 레지스트리로 Durable Files를 갱신합니다.";
MERGE (c:Content {id: "content:dream-cursor"}) SET c.name = "Dream Cursor", c.file = "dict/03_memory_context_session.md", c.description = "Dream이 history.jsonl의 어디까지 처리했는지 기록하는 위치 파일 — Cursor의 한 사례.";
MERGE (c:Content {id: "content:dulwich"}) SET c.name = "dulwich", c.file = "dict/09_dev_stack.md", c.description = "순수 파이썬 Git 구현 — git 바이너리 설치 없이 저장소를 다룰 수 있습니다. Dream의 diff 검증 같은 내부 Git 조작에 쓰입니다.";
MERGE (c:Content {id: "content:durable-files"}) SET c.name = "Durable Files", c.file = "dict/03_memory_context_session.md", c.description = "에이전트의 정체성과 기억을 담는 마크다운 파일들. Dream이 갱신합니다.";
MERGE (c:Content {id: "content:embedding"}) SET c.name = "Embedding", c.file = "dict/08_ai_llm_concepts.md", c.description = "텍스트를 의미가 담긴 숫자 벡터로 바꾼 것 — 의미가 비슷하면 벡터도 가깝습니다. 키워드가 아닌 \"뜻\"으로 검색할 수 있게 하는 토대입니다. (nanobot 미사용 — 일반 개념.)";
MERGE (c:Content {id: "content:entry-point-plugin"}) SET c.name = "Entry-point Plugin", c.file = "dict/02_tools_and_skills.md", c.description = "파이썬 패키징의 Entry Points 규격(`nanobot.tools`, `nanobot.channels` 그룹)으로 별도 설치된 외부 패키지가 도구/채널을 nanobot에 등록하는 방식.";
MERGE (c:Content {id: "content:entry-points"}) SET c.name = "Entry Points", c.file = "dict/09_dev_stack.md", c.description = "파이썬 패키징 표준의 플러그인 선언 규격 — 패키지가 메타데이터에 \"나는 이 그룹에 이 객체를 제공한다\"고 선언하면, 호스트가 설치된 패키지들에서 그룹을 조회해 로드합니다.";
MERGE (c:Content {id: "content:event-loop"}) SET c.name = "Event Loop", c.file = "dict/09_dev_stack.md", c.description = "\"준비된 작업을 하나 꺼내 실행하고, I/O를 기다리는 작업은 재워 두는\" 것을 반복하는 스케줄러 — asyncio 동시성의 심장입니다. 스레드 없이도 수천 개의 대기 작업을 다룰 수 있는 대신, 한 작업이 CPU를 오래 붙들면(블로킹) 전체가 멈춥니다.";
MERGE (c:Content {id: "content:exact-pinning"}) SET c.name = "Exact Pinning", c.file = "dict/09_dev_stack.md", c.description = "의존성 버전에 상한·하한을 두어(`>=x,<y`) 예고 없는 호환성 파괴를 막는 정책. 재현성이 좋아지는 대신 보안 패치 수용이 늦어질 수 있는 트레이드오프가 있습니다.";
MERGE (c:Content {id: "content:exec-session"}) SET c.name = "Exec Session", c.file = "dict/02_tools_and_skills.md", c.description = "상태 유지형(interactive) 셸 세션 관리자(`ExecSessionManager`). 일회성 ExecTool과 달리 프로세스를 살려 두고 WriteStdinTool로 입력을 이어 보낼 수 있습니다.";
MERGE (c:Content {id: "content:exectool"}) SET c.name = "ExecTool", c.file = "dict/02_tools_and_skills.md", c.description = "셸 명령을 실행하는 도구 — 에이전트에게 가장 강력하고 가장 위험한 능력. Sandbox Backend로 명령을 감싸고 하드 Timeout(기본 60초)으로 폭주를 차단합니다. Windows에서는 PowerShell(`pwsh` 우선)이 기본입니다.";
MERGE (c:Content {id: "content:exponential-backoff"}) SET c.name = "Exponential Backoff", c.file = "dict/04_providers_and_llm.md", c.description = "재시도 간격을 1초 → 2초 → 4초 → 8초처럼 지수적으로 늘리는 Retry 전략. 과부하 서버에 일제히 재돌진해 장애를 악화시키는 \"재시도 폭풍(retry storm)\"을 막습니다. 실제 구현은 여기에 무작위 지터(jitter)를 더해 클라이언트들의 재시도 시점을 흩뜨립니다.";
MERGE (c:Content {id: "content:facade-pattern"}) SET c.name = "Facade Pattern", c.file = "dict/01_core_architecture.md", c.description = "복잡한 내부 서브시스템을 간단한 단일 진입 객체 뒤에 숨기는 패턴(GoF). 사용자는 파사드의 몇 개 메서드만 알면 되고, 내부의 여러 구성요소 조립은 파사드가 대신합니다.";
MERGE (c:Content {id: "content:fallbackprovider"}) SET c.name = "FallbackProvider", c.file = "dict/04_providers_and_llm.md", c.description = "여러 프로바이더를 순서대로 시도하는 합성 프로바이더 — 그 자체가 Provider Base 인터페이스를 구현해 어디든 일반 프로바이더처럼 꽂힙니다 (Composite 패턴). 내부에 Retry와 Circuit Breaker를 결합해 Graceful Degradation을 실현합니다.";
MERGE (c:Content {id: "content:few-shot-learning"}) SET c.name = "Few-shot Learning", c.file = "dict/08_ai_llm_concepts.md", c.description = "Prompt에 몇 개의 입력-출력 예시를 넣어 과제 수행 방식을 보여주는 In-Context Learning 기법.";
MERGE (c:Content {id: "content:file-state"}) SET c.name = "File State", c.file = "dict/02_tools_and_skills.md", c.description = "파일 읽기 이력을 추적해 \"읽지 않고 편집\" 경고와 중복 읽기 감지를 제공하는 인프라 모듈 (_SKIP_MODULES 대상). 모델의 부주의한 파일 조작을 절차적으로 견제합니다.";
MERGE (c:Content {id: "content:filelock"}) SET c.name = "filelock", c.file = "dict/09_dev_stack.md", c.description = "파일 기반 프로세스 간 잠금 라이브러리 — 여러 프로세스가 같은 세션/메모리 파일을 동시에 쓰는 경쟁을 막습니다.";
MERGE (c:Content {id: "content:filesystem-tools"}) SET c.name = "Filesystem Tools", c.file = "dict/02_tools_and_skills.md", c.description = "파일 읽기/쓰기/편집/목록 도구 모음. 모든 경로는 Workspace Policy 경계 검사를 거치며, File State로 \"읽기 전 편집\" 경고와 중복 읽기 감지를 합니다 — 모델이 보지도 않은 파일을 덮어쓰는 사고를 막는 안전장치입니다.";
MERGE (c:Content {id: "content:fine-tuning"}) SET c.name = "Fine-tuning", c.file = "dict/08_ai_llm_concepts.md", c.description = "사전학습된 모델의 가중치를 추가 데이터로 더 훈련해 특정 과제/스타일에 맞추는 것. In-Context Learning과 달리 모델 자체가 바뀝니다. 전체 가중치를 다 갱신하는 full fine-tuning은 비용이 커서, 일부만 갱신하는 PEFT가 실무 표준이 되었습니다. (nanobot은 파인튜닝을 쓰지 않고 프롬프트/메모리로 적응합니다.)";
MERGE (c:Content {id: "content:frontmatter"}) SET c.name = "Frontmatter", c.file = "dict/02_tools_and_skills.md", c.description = "Markdown 파일 맨 앞에 `---`로 구분해 넣는 구조화된 메타데이터 블록(YAML 형식). 본문(사람용 텍스트)과 메타데이터(기계용 필드)를 한 파일에 공존시키는 관행입니다.";
MERGE (c:Content {id: "content:fsync"}) SET c.name = "fsync", c.file = "dict/03_memory_context_session.md", c.description = "OS 버퍼에 있는 쓰기 내용을 물리 디스크까지 강제로 내리는 시스템 콜. `write()`만 하면 데이터가 아직 메모리에만 있을 수 있어, 전원 장애 시 유실됩니다. 내구성(durability)이 필요한 저장(체크포인트, 메모리 파일)에서 Atomic Write와 함께 쓰입니다.";
MERGE (c:Content {id: "content:gateway"}) SET c.name = "Gateway", c.file = "dict/01_core_architecture.md", c.description = "`nanobot gateway` 명령으로 뜨는 장기 실행 오케스트레이터. 모든 Channel, CronService, AgentLoop, WebUI를 한 프로세스에서 구동합니다. 상시 대기하는 비서를 만들려면 이 프로세스가 계속 떠 있어야 합니다.";
MERGE (c:Content {id: "content:gateway-service"}) SET c.name = "Gateway Service", c.file = "dict/05_channels_gateway_ui.md", c.description = "Gateway의 실제 구현 — 채널, AgentLoop, CronService, AutoCompact를 기동/정지하는 생명주기 관리자입니다.";
MERGE (c:Content {id: "content:git"}) SET c.name = "Git", c.file = "dict/09_dev_stack.md", c.description = "분산 버전 관리 시스템. nanobot에서는 코드 관리를 넘어 메모리 변경의 감사 추적으로도 쓰입니다 — Dream이 \"실제 diff가 있는가\"로 작업 진위를 검증합니다.";
MERGE (c:Content {id: "content:github-copilot-provider"}) SET c.name = "GitHub Copilot Provider", c.file = "dict/04_providers_and_llm.md", c.description = "GitHub Copilot 구독의 모델 접근권을 사용하는 프로바이더. 디바이스 플로우 OAuth 로그인을 지원합니다.";
MERGE (c:Content {id: "content:goal-state"}) SET c.name = "Goal State", c.file = "dict/03_memory_context_session.md", c.description = "Sustained Goal의 등록/완료 상태를 세션 메타데이터로 관리하는 모듈.";
MERGE (c:Content {id: "content:graceful-degradation"}) SET c.name = "Graceful Degradation", c.file = "dict/04_providers_and_llm.md", c.description = "일부 구성요소가 실패해도 시스템 전체가 죽지 않고 품질을 낮춰서라도 계속 동작하게 하는 신뢰성 원칙. \"최고의 답\" 대신 \"차선의 답\"을, \"차선\"도 안 되면 \"정직한 오류 메시지\"를 반환합니다.";
MERGE (c:Content {id: "content:grounding"}) SET c.name = "Grounding", c.file = "dict/08_ai_llm_concepts.md", c.description = "모델의 출력을 검증 가능한 외부 근거(문서, 도구 실행 결과, DB)에 묶는 것 — Hallucination의 해독제입니다.";
MERGE (c:Content {id: "content:hallucination"}) SET c.name = "Hallucination", c.file = "dict/08_ai_llm_concepts.md", c.description = "모델이 사실이 아닌 내용을 그럴듯하게 생성하는 현상. 모델은 \"가장 그럴듯한 다음 Token\"을 고를 뿐 진위를 검증하지 않기 때문에 구조적으로 발생합니다.";
MERGE (c:Content {id: "content:hatchling"}) SET c.name = "hatchling", c.file = "dict/09_dev_stack.md", c.description = "`pyproject.toml` 기반 파이썬 빌드 백엔드. WebUI 빌드 산출물 (`nanobot/web/dist/`)을 휠에 포함시키는 것도 이 설정입니다.";
MERGE (c:Content {id: "content:health-endpoint"}) SET c.name = "Health Endpoint", c.file = "dict/05_channels_gateway_ui.md", c.description = "프로세스 생존/상태를 HTTP로 알려주는 점검 창구. 컨테이너 오케스트레이터나 모니터링이 \"살아 있나?\"를 기계적으로 확인하는 데 씁니다.";
MERGE (c:Content {id: "content:heartbeat"}) SET c.name = "Heartbeat", c.file = "dict/06_scheduling_automation.md", c.description = "주기적 Cron Job으로 HEARTBEAT.md의 할 일 목록을 점검하는 메커니즘 — \"에이전트의 맥박\". 과거의 전용 Heartbeat 서비스는 제거되고 크론 잡 방식으로 통합되었습니다 (특수 실행 경로 하나를 없앤 단순화). 점검 중 보고 소음은 MessageTool의 `set_suppress_delivery`로 억제됩니다.";
MERGE (c:Content {id: "content:heartbeatmd"}) SET c.name = "HEARTBEAT.md", c.file = "dict/06_scheduling_automation.md", c.description = "Heartbeat가 점검하는 할 일 목록 파일. 사용자와 에이전트 모두 편집할 수 있는 Markdown — \"에이전트의 상비 체크리스트\".";
MERGE (c:Content {id: "content:hierarchical-memory"}) SET c.name = "Hierarchical Memory", c.file = "dict/08_ai_llm_concepts.md", c.description = "기억을 컴퓨터의 메모리 계층처럼 핵심(상시 로드) / 보관(필요 시 로드) 층으로 나누는 아키텍처 — MemGPT(Packer et al., 2023)가 대표 연구입니다. nanobot의 대응: MEMORY.md(상시) vs history.jsonl(보관), 그리고 인지과학의 의미 기억/일화 기억 구분과 평행합니다.";
MERGE (c:Content {id: "content:history-visibility"}) SET c.name = "History Visibility", c.file = "dict/03_memory_context_session.md", c.description = "세션 이력 중 어떤 메시지를 모델/UI에 보일지 제어하는 규칙(내부 마커, 시스템 잡 이력 숨김 등). \"저장은 하되 보여주지는 않는다\"의 구분을 담당합니다.";
MERGE (c:Content {id: "content:historyjsonl"}) SET c.name = "history.jsonl", c.file = "dict/03_memory_context_session.md", c.description = "모든 대화 경험이 append되는 사건 로그 — 인지과학의 일화 기억(episodic memory)에 해당합니다. Dream이 이를 읽어 Durable Files(의미 기억)로 증류합니다.";
MERGE (c:Content {id: "content:hook"}) SET c.name = "Hook", c.file = "dict/01_core_architecture.md", c.description = "턴 진행의 특정 지점(시작/도구 실행/완료)에 끼어들 수 있는 확장점. \"프레임워크가 내 코드를 불러주는\" 제어 역전(Inversion of Control) 방식으로, SDK 사용자가 코어 수정 없이 커스텀 동작을 주입할 수 있습니다.";
MERGE (c:Content {id: "content:http"}) SET c.name = "HTTP", c.file = "dict/05_channels_gateway_ui.md", c.description = "웹의 기본 요청-응답 프로토콜. 클라이언트가 요청(메서드 + URL + 헤더 + 본문)을 보내면 서버가 응답(상태 코드 + 본문)을 돌려줍니다. nanobot에서는 API Server, 웹 fetch 도구, 모든 LLM API 호출(httpx)의 토대입니다.";
MERGE (c:Content {id: "content:httpx"}) SET c.name = "httpx", c.file = "dict/09_dev_stack.md", c.description = "asyncio 네이티브 HTTP 클라이언트. 커스텀 전송 계층을 끼울 수 있어 PinnedDNSAsyncTransport 같은 보안 확장이 가능합니다 — requests의 비동기 시대 후계자입니다.";
MERGE (c:Content {id: "content:image-generation-provider"}) SET c.name = "Image Generation Provider", c.file = "dict/04_providers_and_llm.md", c.description = "텍스트→이미지 생성 백엔드의 추상화. Image Generation Tool이 사용합니다.";
MERGE (c:Content {id: "content:image-generation-tool"}) SET c.name = "Image Generation Tool", c.file = "dict/02_tools_and_skills.md", c.description = "텍스트 프롬프트로 이미지를 생성하는 도구. Image Generation Provider에 위임합니다.";
MERGE (c:Content {id: "content:in-context-learning"}) SET c.name = "In-Context Learning", c.file = "dict/08_ai_llm_concepts.md", c.description = "가중치 갱신(Fine-tuning) 없이 Prompt 안의 정보만으로 모델이 새 지식과 과제를 다루는 능력(GPT-3 논문, Brown et al., 2020에서 부각). nanobot의 Memory와 Skill이 모델을 재훈련하지 않고도 \"학습\"처럼 작동하는 근거가 이것입니다.";
MERGE (c:Content {id: "content:inboundmessage"}) SET c.name = "InboundMessage", c.file = "dict/01_core_architecture.md", c.description = "외부 플랫폼에서 들어온 사용자 메시지를 표준화한 이벤트 객체(채널명, chat_id, sender_id, 본문, 미디어). 모든 Channel이 자기 플랫폼의 메시지를 이 형태로 변환해 MessageBus에 발행하므로, 코어는 플랫폼 차이를 모릅니다. Pydantic 모델이라 필드 누락/타입 오류가 생성 시점에 잡힙니다.";
MERGE (c:Content {id: "content:injection"}) SET c.name = "Injection", c.file = "dict/01_core_architecture.md", c.description = "에이전트가 아직 턴을 도는 도중에 도착한 사용자 메시지를 진행 중인 대화에 끼워 넣는 기능.";
MERGE (c:Content {id: "content:input-budget"}) SET c.name = "Input Budget", c.file = "dict/03_memory_context_session.md", c.description = "한 요청에서 입력이 쓸 수 있는 Token 상한:";
MERGE (c:Content {id: "content:jinja2"}) SET c.name = "Jinja2", c.file = "dict/09_dev_stack.md", c.description = "`{{ 변수 }}`, `{% if %}` 문법의 텍스트 템플릿 엔진. System Prompt 템플릿(`nanobot/templates/`) 렌더링에 사용됩니다 — 프롬프트를 코드에서 분리해 데이터로 관리하게 해 줍니다.";
MERGE (c:Content {id: "content:json-rpc"}) SET c.name = "JSON-RPC", c.file = "dict/08_ai_llm_concepts.md", c.description = "JSON으로 원격 프로시저 호출(요청 `{method, params, id}` / 응답 `{result | error, id}`)을 표현하는 경량 프로토콜. 전송 수단을 규정하지 않아 stdio Transport, HTTP 등 어디에나 실립니다. MCP와 LSP의 공통 기반입니다.";
MERGE (c:Content {id: "content:json-schema"}) SET c.name = "JSON Schema", c.file = "dict/08_ai_llm_concepts.md", c.description = "JSON 데이터의 구조(타입, 필수 필드, 허용값)를 JSON으로 기술하는 표준. Tool Calling에서 도구 파라미터의 \"계약서\" 역할을 합니다 — 모델이 이를 읽고 올바른 형태의 인자를 생성합니다.";
MERGE (c:Content {id: "content:jsonl"}) SET c.name = "JSONL", c.file = "dict/03_memory_context_session.md", c.description = "한 줄에 JSON 객체 하나씩 쌓는 Append-only Log 파일 형식. 손상에 강하고(깨져도 마지막 줄만) 추가가 O(1)이라 세션/이력 저장에 적합합니다.";
MERGE (c:Content {id: "content:last_consolidated-cursor"}) SET c.name = "last_consolidated Cursor", c.file = "dict/03_memory_context_session.md", c.description = "세션 메타데이터에 저장되는 \"여기까지 요약 완료\" 위치 표시 — Cursor의 한 사례입니다.";
MERGE (c:Content {id: "content:least-privilege"}) SET c.name = "Least Privilege", c.file = "dict/07_security_isolation.md", c.description = "각 주체에게 임무 수행에 필요한 최소한의 권한만 부여하는 보안 원칙(Saltzer & Schroeder, 1975). 권한이 없으면 사고도 없다 — 부여하지 않은 능력은 악용될 수도 없습니다.";
MERGE (c:Content {id: "content:linux-namespaces"}) SET c.name = "Linux Namespaces", c.file = "dict/07_security_isolation.md", c.description = "프로세스가 보는 시스템 자원(마운트, PID, 네트워크, 사용자 등)을 분리된 시야로 바꾸는 커널 기능. \"같은 컴퓨터인데 다른 세상\"을 만드는 원리로, Container와 bubblewrap의 공통 토대입니다.";
MERGE (c:Content {id: "content:llm"}) SET c.name = "LLM", c.file = "dict/08_ai_llm_concepts.md", c.description = "방대한 텍스트로 훈련되어 \"지금까지의 텍스트 다음에 올 Token\"의 확률을 계산하는 신경망 — 현대 모델은 대부분 Transformer 구조입니다. 이 단순한 능력(다음 토큰 예측)에서 대화, 코딩, 추론이 창발합니다. nanobot에서는 Provider 뒤의 두뇌입니다.";
MERGE (c:Content {id: "content:loguru"}) SET c.name = "loguru", c.file = "dict/09_dev_stack.md", c.description = "설정이 거의 필요 없는 로깅 라이브러리 — nanobot 전반의 로그 출력을 담당합니다.";
MERGE (c:Content {id: "content:long-task-tool"}) SET c.name = "Long Task Tool", c.file = "dict/02_tools_and_skills.md", c.description = "Sustained Goal을 세션 메타데이터에 등록하는 `LongTaskTool`과 완료를 기록하는 `CompleteGoalTool`. 활성 목표는 매 턴 Runtime Context에 미러링되어, 이력이 압축되어도 \"지금 무엇을 하던 중인지\"가 사라지지 않습니다.";
MERGE (c:Content {id: "content:lora"}) SET c.name = "LoRA", c.file = "dict/08_ai_llm_concepts.md", c.description = "PEFT의 특수한 기법(Hu et al., 2021) — 원래 가중치는 얼려 두고, 그 옆에 저랭크(low-rank) 행렬 한 쌍만 학습해 더합니다. 훈련 파라미터가 1/1000 수준으로 줄고, 학습된 어댑터만 따로 배포/교체할 수 있습니다.";
MERGE (c:Content {id: "content:lost-in-the-middle"}) SET c.name = "Lost in the Middle", c.file = "dict/08_ai_llm_concepts.md", c.description = "긴 컨텍스트에서 모델이 중간에 놓인 정보를 처음/끝보다 잘 놓친다는 실증 연구(Liu et al., 2023). \"창이 크니 다 넣으면 된다\"가 틀렸음을 보여, 중요한 정보를 앞/뒤에 배치하고 중간을 압축하는 설계 (예: Runtime Context를 끝에 배치)의 근거가 됩니다.";
MERGE (c:Content {id: "content:lsp"}) SET c.name = "LSP", c.file = "dict/08_ai_llm_concepts.md", c.description = "에디터와 언어 분석기를 분리한 Microsoft의 표준 — \"M개 에디터 × N개 언어\"를 M+N으로 줄인 선례로, MCP 설계의 직접적 영감입니다. JSON-RPC 기반이라는 점도 같습니다.";
MERGE (c:Content {id: "content:markdown"}) SET c.name = "Markdown", c.file = "dict/02_tools_and_skills.md", c.description = "`#`, `-`, `` 같은 간단한 기호로 서식을 표현하는 경량 마크업 언어. 사람이 읽고 쓰기 쉽고 LLM도 잘 다루기 때문에, nanobot은 기억(MEMORY.md), 스킬(SKILL.md), 프롬프트 템플릿을 모두 마크다운으로 저장합니다 — \"에이전트의 지식은 사람이 열어 볼 수 있는 텍스트\"라는 설계 철학의 토대입니다.";
MERGE (c:Content {id: "content:max_tokens"}) SET c.name = "max_tokens", c.file = "dict/04_providers_and_llm.md", c.description = "한 응답이 생성할 수 있는 최대 Token 수. 이 예약분만큼 Input Budget이 줄어듭니다 — 출력 자리를 미리 비워 두는 좌석 예약 개념입니다.";
MERGE (c:Content {id: "content:mcp"}) SET c.name = "MCP", c.file = "dict/08_ai_llm_concepts.md", c.description = "Anthropic이 2024년 공개한 도구/컨텍스트 연결 표준 — \"AI 도구의 USB-C\"라는 비유처럼, 도구 제공자(서버)와 에이전트(클라이언트)가 서로를 몰라도 JSON-RPC 규약만 지키면 연결됩니다. M개 에이전트 × N개 도구의 조합 문제를 M+N으로 줄입니다.";
MERGE (c:Content {id: "content:mcptoolwrapper"}) SET c.name = "MCPToolWrapper", c.file = "dict/02_tools_and_skills.md", c.description = "MCP 서버가 제공하는 원격 도구를 nanobot Tool 인터페이스로 감싸는 Adapter Pattern 구현. 도구 이름에 `mcp_<server>_` 접두를 붙이고, stdio Transport와 HTTP/SSE를 지원하며, 원격 연결은 PinnedDNSAsyncTransport로 보호합니다.";
MERGE (c:Content {id: "content:memory"}) SET c.name = "Memory", c.file = "dict/03_memory_context_session.md", c.description = "대화가 끝나도 유지되는 지식 저장소. LLM 자체는 아무것도 기억하지 못하므로(무상태), 기억은 런타임이 파일로 만들어 매번 다시 보여주는 것입니다. nanobot은 벡터 DB가 아니라 사람이 읽을 수 있는 Markdown Durable Files를 씁니다 — 투명하고 Git으로 감사 가능합니다.";
MERGE (c:Content {id: "content:memorymd"}) SET c.name = "MEMORY.md", c.file = "dict/03_memory_context_session.md", c.description = "축적된 사실/선호를 담는 장기 기억 파일 — 인지과학의 의미 기억(semantic memory)에 해당합니다 (Hierarchical Memory 참조).";
MERGE (c:Content {id: "content:messagebus"}) SET c.name = "MessageBus", c.file = "dict/01_core_architecture.md", c.description = "Channel과 에이전트 코어를 Decoupling하는 비동기 버스. inbound/outbound 두 개의 asyncio.Queue를 갖고, 채널은 발행만, AgentLoop는 소비만 하므로 서로의 구현을 몰라도 됩니다 — Producer-Consumer 패턴의 적용입니다.";
MERGE (c:Content {id: "content:messagetool"}) SET c.name = "MessageTool", c.file = "dict/02_tools_and_skills.md", c.description = "에이전트가 턴 도중 사용자에게 직접 메시지를 보내는 도구 — 긴 작업 중의 중간 보고에 쓰입니다. Heartbeat 실행 중에는 `set_suppress_delivery`로 전송이 억제됩니다(할 일 점검 때마다 사용자에게 알림이 가는 소음 방지).";
MERGE (c:Content {id: "content:model-preset"}) SET c.name = "Model Preset", c.file = "dict/01_core_architecture.md", c.description = "\"이 용도에는 이 프로바이더의 이 모델과 이 파라미터\"를 묶어 이름 붙인 설정 단위 — 수동 Model Routing의 수단.";
MERGE (c:Content {id: "content:model-routing"}) SET c.name = "Model Routing", c.file = "dict/08_ai_llm_concepts.md", c.description = "요청 성격에 따라 다른 모델로 보내는 전략 — 비용/품질/가용성의 균형이 목적입니다 (FrugalGPT, Chen et al., 2023 계열 연구).";
MERGE (c:Content {id: "content:mytool"}) SET c.name = "MyTool", c.file = "dict/02_tools_and_skills.md", c.description = "에이전트가 자기 자신의 런타임 상태를 조회/조작하는 도구. Runtime State Protocol을 통해 AgentLoop 상태에 접근합니다 — 도구가 루프 구현에 직접 의존하지 않게 하는 경계를 사이에 둡니다.";
MERGE (c:Content {id: "content:nanobot-sdk-facade"}) SET c.name = "Nanobot (SDK Facade)", c.file = "dict/01_core_architecture.md", c.description = "nanobot을 파이썬 라이브러리로 임베드하기 위한 진입점 클래스 — Facade Pattern의 구현. `Nanobot.from_config()`으로 만들고 `await bot.run(\"...\")`으로 한 턴을 실행합니다.";
MERGE (c:Content {id: "content:openai-codex-provider"}) SET c.name = "OpenAI Codex Provider", c.file = "dict/04_providers_and_llm.md", c.description = "ChatGPT 구독(Codex) 백엔드를 사용하는 프로바이더.";
MERGE (c:Content {id: "content:openai-compatible-api"}) SET c.name = "OpenAI-Compatible API", c.file = "dict/05_channels_gateway_ui.md", c.description = "OpenAI Chat Completions API의 요청/응답 형식(JSON 스키마, 엔드포인트 경로)을 그대로 따르는 것 — 사실상(de facto)의 업계 표준 규격입니다. 클라이언트 생태계(SDK, 앱)를 재사용할 수 있어, nanobot은 서버로서 이를 제공하고(API Server), 클라이언트로서도 이를 사용합니다 (OpenAI-Compatible Provider).";
MERGE (c:Content {id: "content:openai-compatible-provider"}) SET c.name = "OpenAI-Compatible Provider", c.file = "dict/04_providers_and_llm.md", c.description = "OpenAI-Compatible API(Chat Completions 규격)를 말하는 모든 백엔드용 프로바이더 — OpenAI 본가는 물론 OpenRouter, Ollama(로컬), vLLM 등 \"사실상 표준\"을 따르는 서버 전부에 재사용됩니다. base URL만 바꾸면 됩니다.";
MERGE (c:Content {id: "content:openai-responses-provider"}) SET c.name = "OpenAI Responses Provider", c.file = "dict/04_providers_and_llm.md", c.description = "OpenAI의 신형 Responses API(Chat Completions의 후속 규격)용 프로바이더.";
MERGE (c:Content {id: "content:optional-dependencies"}) SET c.name = "Optional Dependencies", c.file = "dict/09_dev_stack.md", c.description = "`pip install nanobot-ai[telegram]`처럼 필요한 기능의 의존성만 골라 설치하는 파이썬 패키징 기능. 20개 가까운 채널/프로바이더의 SDK를 전부 설치하면 무겁기 때문에, 기본 설치는 가볍게 유지하고 `nanobot/optional_features.py`가 미설치 기능 사용 시 안내 메시지를 냅니다 — \"lazy deps\" 설계.";
MERGE (c:Content {id: "content:orphan-tool-result"}) SET c.name = "Orphan Tool Result", c.file = "dict/03_memory_context_session.md", c.description = "짝이 되는 tool_call이 (절단 등으로) 사라진 tool result 메시지. 모든 tool result는 대응하는 tool_call과 짝을 이뤄야 한다는 Tool Calling API 규칙 때문에, 고아가 있으면 Provider가 요청 전체를 거부합니다. Context Governance가 제거하거나 누락된 짝을 백필합니다.";
MERGE (c:Content {id: "content:outboundmessage"}) SET c.name = "OutboundMessage", c.file = "dict/01_core_architecture.md", c.description = "에이전트의 응답을 표준화한 이벤트 객체. MessageBus를 거쳐 원래 Channel이 플랫폼별 형식(Telegram 마크다운, Slack 블록 등)으로 변환해 전송합니다.";
MERGE (c:Content {id: "content:pairing"}) SET c.name = "Pairing", c.file = "dict/01_core_architecture.md", c.description = "모르는 사람의 DM에 에이전트가 응답하지 않도록, 채널별 페어링 코드로 발신자를 승인하는 절차와 그 저장소. 개인 비서가 아무에게나 대답하면 안 되기 때문입니다.";
MERGE (c:Content {id: "content:path-utils"}) SET c.name = "Path Utils", c.file = "dict/02_tools_and_skills.md", c.description = "워크스페이스 스코프 도구들이 공유하는 경로 헬퍼. Workspace Policy 경계 검사와 연동됩니다.";
MERGE (c:Content {id: "content:peft"}) SET c.name = "PEFT", c.file = "dict/08_ai_llm_concepts.md", c.description = "Fine-tuning의 특수한 방법론 — 모델 전체가 아니라 아주 작은 일부 파라미터만 훈련해 비슷한 효과를 얻습니다. 수천억 파라미터 모델도 소비자 GPU에서 튜닝할 수 있게 한 실용적 돌파구입니다. LoRA가 가장 널리 쓰이는 PEFT 기법입니다. (nanobot에는 직접 구현되지 않은 일반 개념입니다.)";
MERGE (c:Content {id: "content:pinneddnsasynctransport"}) SET c.name = "PinnedDNSAsyncTransport", c.file = "dict/07_security_isolation.md", c.description = "DNS Pinning을 구현한 httpx 커스텀 전송 계층. Web Tools와 원격 MCPToolWrapper 연결에 쓰입니다.";
MERGE (c:Content {id: "content:pkgutil"}) SET c.name = "pkgutil", c.file = "dict/09_dev_stack.md", c.description = "패키지 안의 모듈을 열거하는 파이썬 표준 라이브러리. Tool Discovery와 Channel Registry의 자동 발견이 이것으로 구현됩니다.";
MERGE (c:Content {id: "content:platform-channels"}) SET c.name = "Platform Channels", c.file = "dict/05_channels_gateway_ui.md", c.description = "Telegram, Discord, Slack, Feishu, Matrix, WhatsApp, Email 등 실제 메시징 플랫폼별 Channel 구현들. 각 플랫폼 SDK는 Optional Dependencies라서 쓰는 것만 설치합니다 (`pip install nanobot-ai[telegram]`).";
MERGE (c:Content {id: "content:plugin-architecture"}) SET c.name = "Plugin Architecture", c.file = "dict/02_tools_and_skills.md", c.description = "코어를 수정하지 않고 외부에서 기능을 꽂아 넣을 수 있게 확장점을 설계하는 방식. \"Core stays small; extend at the edges\"라는 nanobot의 설계 이념(`.agent/design.md`) 그 자체입니다.";
MERGE (c:Content {id: "content:producer-consumer"}) SET c.name = "Producer-Consumer", c.file = "dict/01_core_architecture.md", c.description = "생산자는 큐에 넣기만 하고 소비자는 큐에서 꺼내기만 하는 동시성 패턴. 양쪽이 서로를 기다리지 않아도 되고(속도 차 흡수), 서로의 존재를 몰라도 됩니다. 큐가 완충재(buffer) 역할을 합니다.";
MERGE (c:Content {id: "content:progress-hook"}) SET c.name = "Progress Hook", c.file = "dict/01_core_architecture.md", c.description = "턴 진행 상황(어떤 도구를 실행 중인지 등)을 실시간으로 밖에 알리는 Hook의 특수화. WebUI의 Tool Hint 표시가 이를 사용합니다.";
MERGE (c:Content {id: "content:progressive-disclosure"}) SET c.name = "Progressive Disclosure", c.file = "dict/02_tools_and_skills.md", c.description = "스킬 요약(이름+한 줄)만 상시 컨텍스트에 넣고, 본문은 필요할 때 파일 읽기로 로드하는 2단계 구조.";
MERGE (c:Content {id: "content:prompt"}) SET c.name = "Prompt", c.file = "dict/08_ai_llm_concepts.md", c.description = "LLM에 주는 입력 텍스트 전체. 모델의 행동을 바꾸는 유일한 손잡이가 프롬프트이므로, \"무엇을 어떻게 써 넣을까\"가 하나의 기술(Prompt Engineering)이 됩니다.";
MERGE (c:Content {id: "content:prompt-caching"}) SET c.name = "Prompt Caching", c.file = "dict/04_providers_and_llm.md", c.description = "요청 간 동일한 프롬프트 앞부분(prefix) 의 처리 결과를 API 서버가 재사용해 비용·지연을 줄이는 기능(Anthropic 기준 캐시 적중분 비용 ~1/10). \"앞부분이 완전히 같아야\" 적중하므로, nanobot은 매 턴 바뀌는 정보(Runtime Context)를 프롬프트 뒤쪽에 배치합니다.";
MERGE (c:Content {id: "content:prompt-engineering"}) SET c.name = "Prompt Engineering", c.file = "dict/08_ai_llm_concepts.md", c.description = "원하는 출력을 얻도록 Prompt를 설계·개선하는 실무 기법. 역할 부여(\"너는 사서다\"), 형식 지정(\"JSON으로\"), 예시 제공(Few-shot Learning), 단계적 사고 유도 (Chain-of-Thought)가 대표 기법입니다. nanobot의 `nanobot/templates/`가 프롬프트 엔지니어링의 산물입니다.";
MERGE (c:Content {id: "content:prompt-injection"}) SET c.name = "Prompt Injection", c.file = "dict/07_security_isolation.md", c.description = "외부에서 온 데이터 속에 숨은 지시문이 모델의 원래 지시를 탈취하는 공격. LLM이 \"데이터\"와 \"명령\"을 구조적으로 구분하지 못하는 데서 생기는, 에이전트 시대의 SQL 인젝션입니다.";
MERGE (c:Content {id: "content:prompt-toolkit"}) SET c.name = "prompt-toolkit", c.file = "dict/09_dev_stack.md", c.description = "고급 터미널 입력(멀티라인, 히스토리, 자동완성) 라이브러리 — CLI 대화 모드의 입력 담당.";
MERGE (c:Content {id: "content:provider"}) SET c.name = "Provider", c.file = "dict/01_core_architecture.md", c.description = "LLM 백엔드의 공통 추상화 — \"메시지 목록과 도구 목록을 주면 응답/도구 호출을 돌려주는\" 인터페이스. 어떤 벤더든 같은 방식으로 갈아끼울 수 있게 하는 Adapter Pattern입니다.";
MERGE (c:Content {id: "content:provider-base"}) SET c.name = "Provider Base", c.file = "dict/04_providers_and_llm.md", c.description = "모든 프로바이더가 상속하는 추상 클래스 — \"메시지 + 도구 목록 → 응답/도구 호출\"이라는 공통 계약을 정의합니다. 이 계약 덕에 상위 코드는 어느 벤더인지 신경 쓰지 않습니다.";
MERGE (c:Content {id: "content:provider-factory"}) SET c.name = "Provider Factory", c.file = "dict/04_providers_and_llm.md", c.description = "Config를 읽어 실제 프로바이더 인스턴스를 조립하는 팩토리. 폴백 설정이 있으면 FallbackProvider로 감쌉니다 — \"무엇을 만들지\"를 설정이 결정하고 코드는 조립만 하는 구조입니다.";
MERGE (c:Content {id: "content:provider-registry"}) SET c.name = "Provider Registry", c.file = "dict/04_providers_and_llm.md", c.description = "ProviderSpec 목록을 갖고 모델명/설정으로 프로바이더를 선택하는 Registry Pattern 구현.";
MERGE (c:Content {id: "content:providerspec"}) SET c.name = "ProviderSpec", c.file = "dict/04_providers_and_llm.md", c.description = "프로바이더 하나의 명세(이름, 모델 접두 패턴, 팩토리, 필요 Optional Dependencies). 선언적 데이터로 두어, 새 프로바이더 추가가 \"spec 하나 추가\"로 끝나게 합니다.";
MERGE (c:Content {id: "content:pth-file-guard"}) SET c.name = "PTH File Guard", c.file = "dict/07_security_isolation.md", c.description = "파이썬 `.pth` 파일(인터프리터 시작 시 자동 실행됨)을 통한 코드 주입을 CLI 진입 시점에 점검하는 가드. 잘 알려지지 않은 파이썬 공급망 공격면 하나를 막는 조치입니다.";
MERGE (c:Content {id: "content:pydantic"}) SET c.name = "Pydantic", c.file = "dict/09_dev_stack.md", c.description = "Type Hint를 런타임 데이터 검증으로 바꿔 주는 라이브러리 — 잘못된 데이터가 모델 생성 시점에 즉시 오류를 냅니다. nanobot의 Config, 버스 이벤트, 크론 타입이 모두 Pydantic 모델입니다.";
MERGE (c:Content {id: "content:pydantic-settings"}) SET c.name = "pydantic-settings", c.file = "dict/09_dev_stack.md", c.description = "Pydantic 모델로 환경변수/설정 파일을 로드하는 확장 — Config 로딩에 사용됩니다.";
MERGE (c:Content {id: "content:pypi"}) SET c.name = "PyPI", c.file = "dict/09_dev_stack.md", c.description = "파이썬 패키지의 공식 저장소 — `pip install`이 내려받는 곳. nanobot은 `nanobot-ai`라는 이름으로 배포되며, hatchling이 빌드한 휠(wheel)이 올라갑니다.";
MERGE (c:Content {id: "content:pytest"}) SET c.name = "pytest", c.file = "dict/09_dev_stack.md", c.description = "파이썬 테스트 프레임워크. 이 저장소는 `asyncio_mode = \"auto\"`로 async 테스트를 데코레이터 없이 지원하며, `tests/`는 `nanobot/` 패키지 구조를 미러링합니다.";
MERGE (c:Content {id: "content:python-311"}) SET c.name = "Python 3.11+", c.file = "dict/09_dev_stack.md", c.description = "nanobot의 구현 언어와 최소 버전(`pyproject.toml`의 `requires-python`). 3.11은 asyncio 성능 개선, 더 나은 오류 메시지, `Self` 타입 등을 제공합니다.";
MERGE (c:Content {id: "content:questionary"}) SET c.name = "questionary", c.file = "dict/09_dev_stack.md", c.description = "대화형 선택 프롬프트(화살표로 고르기) 라이브러리 — `nanobot onboard` 마법사에 쓰입니다.";
MERGE (c:Content {id: "content:rag"}) SET c.name = "RAG", c.file = "dict/08_ai_llm_concepts.md", c.description = "질문과 관련된 문서를 Embedding 검색으로 찾아 Prompt에 붙여 주고 답하게 하는 Grounding 기법(Lewis et al., 2020). nanobot은 벡터 검색 RAG 대신 파일 기반 Memory와 도구 실행이라는 다른 노선을 택했습니다 — 직접 구현되지 않은 일반 개념입니다.";
MERGE (c:Content {id: "content:rate-limit"}) SET c.name = "Rate Limit", c.file = "dict/04_providers_and_llm.md", c.description = "API 제공자가 정한 시간당 요청/토큰 상한. 초과 시 HTTP 429가 반환되며, 응답의 `retry-after`를 존중해 기다렸다 재시도하는 것이 예의이자 정석입니다.";
MERGE (c:Content {id: "content:react"}) SET c.name = "ReAct", c.file = "dict/08_ai_llm_concepts.md", c.description = "*ReAct: Synergizing Reasoning and Acting in Language Models*(Yao et al., 2022) — 추론(Reasoning)과 행동(Acting)을 교대로 수행하면 각각 단독보다 훨씬 낫다는 것을 보인 논문. 현대 Agent Loop (concept)의 이론적 기원입니다.";
MERGE (c:Content {id: "content:react-js"}) SET c.name = "React (JS)", c.file = "dict/09_dev_stack.md", c.description = "컴포넌트 기반 UI 자바스크립트 라이브러리 — WebUI의 화면 계층. (AI 논문 ReAct와는 무관합니다.)";
MERGE (c:Content {id: "content:reasoning-blocks"}) SET c.name = "Reasoning Blocks", c.file = "dict/04_providers_and_llm.md", c.description = "일부 모델이 최종 답변과 별도로 출력하는 \"생각 과정\" 콘텐츠(Claude extended thinking 등). 프로바이더가 이를 인식해 표시/보존 여부를 처리해야 합니다.";
MERGE (c:Content {id: "content:reflection"}) SET c.name = "Reflection", c.file = "dict/08_ai_llm_concepts.md", c.description = "에이전트가 자기 경험/출력을 되돌아보고 교훈을 추출해 다음 행동을 개선하는 패턴(Reflexion, Shinn et al., 2023; Generative Agents, Park et al., 2023). nanobot의 Dream은 반성의 보수적 구현 — 교훈을 파일 diff라는 검증 가능한 형태로만 인정합니다.";
MERGE (c:Content {id: "content:registry-pattern"}) SET c.name = "Registry Pattern", c.file = "dict/02_tools_and_skills.md", c.description = "\"이름 → 객체\" 매핑을 중앙 등록소 하나에 모아, 이름만 알면 어떤 구현이든 찾아 쓸 수 있게 하는 패턴. 새 항목 추가가 \"등록 한 줄\"로 끝나므로 Plugin Architecture의 기반이 됩니다.";
MERGE (c:Content {id: "content:retry"}) SET c.name = "Retry", c.file = "dict/04_providers_and_llm.md", c.description = "Transient Error에 한해 같은 요청을 다시 보내는 것. 4xx 같은 영구 오류를 재시도하는 것은 낭비이므로, \"무엇이 일시적인가\"의 판별이 핵심입니다.";
MERGE (c:Content {id: "content:rich"}) SET c.name = "Rich", c.file = "dict/09_dev_stack.md", c.description = "터미널에 색·표·마크다운을 렌더링하는 라이브러리. CLI 대화 모드의 출력 품질을 담당합니다.";
MERGE (c:Content {id: "content:ruff"}) SET c.name = "ruff", c.file = "dict/09_dev_stack.md", c.description = "Rust로 만든 초고속 파이썬 린터/포매터. 이 저장소의 규칙: `E, F, I, N, W`(E501 제외), 라인 길이 100.";
MERGE (c:Content {id: "content:runtime-checkpoint"}) SET c.name = "Runtime Checkpoint", c.file = "dict/01_core_architecture.md", c.description = "턴 도중 상태를 저장해 크래시 후 복구할 수 있게 하는 영속화 장치. TurnState의 단계 정보와 함께, \"저장 안 된 진행분\"이 통째로 날아가는 것을 막습니다.";
MERGE (c:Content {id: "content:runtime-context"}) SET c.name = "Runtime Context", c.file = "dict/03_memory_context_session.md", c.description = "매 턴 갱신되는 실행 정보 블록 — 현재 시각, 활성 Sustained Goal 등. Prompt Caching 적중을 위해 사용자 콘텐츠 뒤에 붙여 앞부분(prefix)을 안정시킵니다. \"시계는 맨 뒤에 차고 있어야 캐시가 산다\"는 배치의 묘입니다.";
MERGE (c:Content {id: "content:runtime-state-protocol"}) SET c.name = "Runtime State Protocol", c.file = "dict/02_tools_and_skills.md", c.description = "AgentLoop 상태를 MyTool에 노출하는 파이썬 Protocol (구조적 타이핑 인터페이스 — \"이 메서드들만 있으면 무엇이든 OK\"). Decoupling의 타입 수준 실현입니다.";
MERGE (c:Content {id: "content:sampling"}) SET c.name = "Sampling", c.file = "dict/04_providers_and_llm.md", c.description = "LLM이 다음 Token을 고를 때 확률분포에서 추첨하는 과정. 같은 질문에 다른 답이 나오는 이유가 이것입니다. 추첨의 성격을 조절하는 손잡이가 Temperature, top-p(누적 확률 상위만 후보로 남김) 등입니다.";
MERGE (c:Content {id: "content:sandbox"}) SET c.name = "Sandbox", c.file = "dict/07_security_isolation.md", c.description = "프로그램을 제한된 환경(\"모래 놀이터\") 안에서 실행해, 잘못되어도 피해가 그 안에 갇히게 하는 격리 개념. 에이전트의 셸 실행(ExecTool)처럼 \"모델이 시키는 대로 실행\"하는 위험한 능력에 필수적입니다.";
MERGE (c:Content {id: "content:sandbox-backend"}) SET c.name = "Sandbox Backend", c.file = "dict/07_security_isolation.md", c.description = "셸 명령을 감싸는 격리 구현의 추상화 — 환경에 따라 bubblewrap, Container, 또는 격리 없음(none)을 선택합니다. \"격리 방식\"을 교체 가능한 전략으로 분리한 설계입니다.";
MERGE (c:Content {id: "content:sdk-clients"}) SET c.name = "SDK Clients", c.file = "dict/05_channels_gateway_ui.md", c.description = "게이트웨이에 원격 접속하는 파이썬 클라이언트. 인프로세스 임베드인 Nanobot (SDK Facade)와 달리, 이미 떠 있는 게이트웨이에 네트워크로 붙습니다.";
MERGE (c:Content {id: "content:seccomp"}) SET c.name = "seccomp", c.file = "dict/07_security_isolation.md", c.description = "프로세스가 호출할 수 있는 시스템 콜을 화이트리스트로 제한하는 리눅스 커널 기능. Linux Namespaces가 \"보이는 것\"을 줄인다면 seccomp은 \"할 수 있는 것\"을 줄입니다 — 격리의 다른 축.";
MERGE (c:Content {id: "content:self-attention"}) SET c.name = "Self-Attention", c.file = "dict/08_ai_llm_concepts.md", c.description = "Transformer의 핵심 연산 — 입력의 각 Token이 다른 모든 토큰을 \"얼마나 주목할지\"를 학습된 가중치로 계산합니다. 계산량이 토큰 수의 제곱에 비례하기 때문에 Context Window에 상한이 생기고, 그래서 Context Compression이 필요해집니다 — 이 사전의 여러 용어가 결국 이 제곱 비용에서 파생됩니다.";
MERGE (c:Content {id: "content:session"}) SET c.name = "Session", c.file = "dict/01_core_architecture.md", c.description = "하나의 대화 맥락과 그 이력. \"어제 하던 이야기\"를 이어가려면 어딘가에 대화가 저장되어 있어야 하는데, 그 저장 단위가 세션입니다. nanobot은 세션을 JSONL 파일 (`<workspace>/sessions/*.jsonl`)로 저장합니다 — SQLite 같은 DB가 아니라 사람이 열어 볼 수 있는 텍스트 파일입니다.";
MERGE (c:Content {id: "content:session-delivery"}) SET c.name = "Session Delivery", c.file = "dict/06_scheduling_automation.md", c.description = "크론 실행 결과를 어느 세션/채널로 전달할지 결정하는 계층.";
MERGE (c:Content {id: "content:session-key"}) SET c.name = "Session Key", c.file = "dict/01_core_architecture.md", c.description = "세션을 식별하는 문자열. 채널·chat_id 조합으로 결정되며, 같은 키의 메시지는 같은 대화 이력을 공유합니다.";
MERGE (c:Content {id: "content:session-manager"}) SET c.name = "Session Manager", c.file = "dict/03_memory_context_session.md", c.description = "Session의 JSONL 저장/로드/압축을 담당. `get_history(max_tokens=...)`로 토큰 예산 내의 이력을 돌려줍니다. 저장은 Atomic Write로 해 크래시에도 파일이 반쯤 깨지지 않게 합니다.";
MERGE (c:Content {id: "content:skill"}) SET c.name = "Skill", c.file = "dict/01_core_architecture.md", c.description = "코드가 아니라 마크다운(SKILL.md) 로 기술된 작업 절차/지식. Tool이 \"할 수 있는 것\"(능력)이라면 스킬은 \"하는 방법\"(노하우)입니다.";
MERGE (c:Content {id: "content:skill-creator"}) SET c.name = "skill-creator", c.file = "dict/02_tools_and_skills.md", c.description = "\"새 스킬을 만드는 방법\"을 기술한 내장 스킬 — 에이전트가 스스로 능력을 확장할 수 있게 하는 자기개선 장치. \"스킬을 만드는 스킬\"이라는 메타 구조가 핵심입니다 (Reflection, Voyager 계열).";
MERGE (c:Content {id: "content:skill-library"}) SET c.name = "Skill Library", c.file = "dict/08_ai_llm_concepts.md", c.description = "에이전트가 획득한 능력을 재사용 가능한 형태로 축적하는 저장소 개념 — Voyager가 게임 환경에서 실증했습니다. nanobot의 Skill 디렉토리 + skill-creator가 이 개념의 마크다운 구현입니다.";
MERGE (c:Content {id: "content:skillmd"}) SET c.name = "SKILL.md", c.file = "dict/02_tools_and_skills.md", c.description = "스킬 하나를 기술하는 마크다운 파일 형식 — Frontmatter 메타데이터(이름, 한 줄 설명) + 본문 절차. Anthropic Agent Skills 규격과 같은 계열입니다.";
MERGE (c:Content {id: "content:skillsloader"}) SET c.name = "SkillsLoader", c.file = "dict/02_tools_and_skills.md", c.description = "내장(`nanobot/skills/`)과 워크스페이스의 Skill을 찾아 읽는 로더. 워크스페이스 스킬이 같은 이름의 내장 스킬을 오버라이드합니다(사용자 커스텀 우선). `build_skills_summary()`로 요약만 컨텍스트에 넣습니다 — Progressive Disclosure의 구현.";
MERGE (c:Content {id: "content:slash-command"}) SET c.name = "Slash Command", c.file = "dict/01_core_architecture.md", c.description = "`/new`, `/help`처럼 채팅에서 바로 실행되는 내장 명령. LLM 호출 없이 Command Router가 처리하므로 빠르고, 항상 같은 결과를 냅니다.";
MERGE (c:Content {id: "content:sliding-window"}) SET c.name = "Sliding Window", c.file = "dict/08_ai_llm_concepts.md", c.description = "항상 최근 N개만 유지하고 오래된 것부터 버리는/접는 기법 — 대화에서는 최근 문맥이 가장 중요하다는 관찰에 기반합니다. nanobot AutoCompact의 \"최근 8개 메시지 원문 유지\"가 이 원리입니다.";
MERGE (c:Content {id: "content:soulmd"}) SET c.name = "SOUL.md", c.file = "dict/03_memory_context_session.md", c.description = "에이전트의 성격/정체성을 정의하는 파일. System Prompt에 주입되며, Dream의 갱신 대상이기도 합니다 — 에이전트가 경험을 통해 \"성격이 다듬어질\" 수 있는 통로.";
MERGE (c:Content {id: "content:spa"}) SET c.name = "SPA", c.file = "dict/05_channels_gateway_ui.md", c.description = "페이지 이동 없이 자바스크립트가 화면을 갈아끼우는 웹앱 형태. 첫 로드 후에는 서버와 데이터만 주고받아 네이티브 앱 같은 사용감을 줍니다. React (JS) 같은 UI 라이브러리가 이 방식의 표준 도구입니다.";
MERGE (c:Content {id: "content:spawntool"}) SET c.name = "SpawnTool", c.file = "dict/02_tools_and_skills.md", c.description = "Subagent를 띄워 작업을 위임하는 도구.";
MERGE (c:Content {id: "content:sse"}) SET c.name = "SSE", c.file = "dict/08_ai_llm_concepts.md", c.description = "HTTP 연결을 열어 두고 서버가 텍스트 이벤트를 단방향으로 흘려 보내는 표준. LLM API Streaming의 사실상 표준 전송이며, MCP의 원격 전송에도 쓰였습니다(현재는 Streamable HTTP로 대체 중).";
MERGE (c:Content {id: "content:ssrf"}) SET c.name = "SSRF", c.file = "dict/07_security_isolation.md", c.description = "서버(여기서는 에이전트)를 속여 공격자가 직접 접근할 수 없는 내부 자원에 대신 요청하게 하는 공격.";
MERGE (c:Content {id: "content:state-machine"}) SET c.name = "State Machine", c.file = "dict/01_core_architecture.md", c.description = "시스템이 가질 수 있는 상태(state)의 유한한 집합과 상태 간 전이(transition) 규칙으로 동작을 기술하는 모델. \"지금 어느 상태인가\"만 알면 다음에 무엇을 해야 하는지가 결정되므로, 복잡한 흐름을 추적·복구 가능하게 만듭니다.";
MERGE (c:Content {id: "content:stdio-transport"}) SET c.name = "stdio Transport", c.file = "dict/08_ai_llm_concepts.md", c.description = "로컬 자식 프로세스와 stdin/stdout 파이프로 JSON-RPC를 주고받는 MCP 전송 방식. 네트워크 포트가 필요 없어 로컬 도구 서버에 가장 간단한 선택입니다.";
MERGE (c:Content {id: "content:streamable-http"}) SET c.name = "Streamable HTTP", c.file = "dict/08_ai_llm_concepts.md", c.description = "MCP의 신형 원격 전송 — 단일 HTTP 엔드포인트로 요청하고 응답을 스트리밍할 수 있어 SSE 방식보다 인프라(로드밸런서 등) 친화적입니다.";
MERGE (c:Content {id: "content:streaming"}) SET c.name = "Streaming", c.file = "dict/04_providers_and_llm.md", c.description = "응답이 완성되기를 기다리지 않고 Delta(조각) 단위로 받는 방식. 첫 글자까지의 체감 지연을 크게 줄입니다 — 30초 걸릴 답변도 1초 만에 \"쓰기 시작\"하는 것처럼 보입니다. 전송 계층으로는 주로 SSE가 쓰입니다.";
MERGE (c:Content {id: "content:subagent"}) SET c.name = "Subagent", c.file = "dict/01_core_architecture.md", c.description = "메인 에이전트가 SpawnTool로 띄우는 격리된 배경 작업자. 자체 대화와 제한된 Tool Scope를 갖고, 완료 결과만 부모에게 보고합니다. 긴 작업을 메인 대화를 막지 않고 처리하는 수단입니다.";
MERGE (c:Content {id: "content:summarization"}) SET c.name = "Summarization", c.file = "dict/08_ai_llm_concepts.md", c.description = "긴 텍스트를 짧게 줄이되 핵심을 보존하는 것 — LLM 스스로가 훌륭한 요약기라는 점을 이용해, \"모델의 기억을 모델이 요약\"하는 재귀적 구조가 가능합니다 (Consolidation이 그 구현).";
MERGE (c:Content {id: "content:sustained-goal"}) SET c.name = "Sustained Goal", c.file = "dict/03_memory_context_session.md", c.description = "한 Turn을 넘어 계속 추적되는 목표. Long Task Tool이 세션 메타데이터에 등록하고, 매 턴 Runtime Context에 미러링되어 이력 압축 후에도 유지됩니다.";
MERGE (c:Content {id: "content:system-prompt"}) SET c.name = "System Prompt", c.file = "dict/03_memory_context_session.md", c.description = "모델에게 정체성·규칙·환경을 알려주는 최상단 지시문 — Prompt의 특수한 형태로, 사용자 메시지보다 높은 권위를 갖도록 취급됩니다. nanobot은 Jinja2 마크다운 템플릿(`identity.md`, `platform_policy.md` 등)에서 렌더링합니다. `.agent/gotchas.md`의 경고처럼, 템플릿 수정은 코드 수정만큼 에이전트 행동을 바꿉니다.";
MERGE (c:Content {id: "content:temperature"}) SET c.name = "Temperature", c.file = "dict/04_providers_and_llm.md", c.description = "Sampling 무작위성 조절 파라미터. 0에 가까우면 가장 확률 높은 토큰만 골라 결정적이고, 높을수록(1~2) 다양하고 창의적이지만 불안정합니다.";
MERGE (c:Content {id: "content:tiktoken"}) SET c.name = "tiktoken", c.file = "dict/08_ai_llm_concepts.md", c.description = "OpenAI의 BPE 토크나이저 구현(Rust 코어라 빠름). nanobot은 Input Budget 계산과 AutoCompact 임계 판정 등 토큰 수 추정에 사용합니다.";
MERGE (c:Content {id: "content:timeout"}) SET c.name = "Timeout", c.file = "dict/07_security_isolation.md", c.description = "작업에 시간 상한을 걸어 초과 시 강제 종료하는 장치. 무한 루프, 응답 없는 네트워크로부터 시스템을 지키는 가장 단순하고 확실한 방어입니다.";
MERGE (c:Content {id: "content:toctou"}) SET c.name = "TOCTOU", c.file = "dict/07_security_isolation.md", c.description = "\"검사한 시점\"과 \"사용한 시점\" 사이에 상태가 바뀌어 검사가 무효가 되는 경쟁 조건(race condition) 계열의 취약점 유형.";
MERGE (c:Content {id: "content:token"}) SET c.name = "Token", c.file = "dict/08_ai_llm_concepts.md", c.description = "LLM이 텍스트를 처리하는 최소 단위 — 단어보다 작을 수 있는 조각입니다. 비용, 속도, Context Window가 모두 토큰 단위로 계산되므로 에이전트 설계의 \"화폐\"입니다.";
MERGE (c:Content {id: "content:tokenizer"}) SET c.name = "Tokenizer", c.file = "dict/08_ai_llm_concepts.md", c.description = "텍스트 ↔ Token 열 변환기. 모델마다 어휘와 분절 규칙이 달라, 같은 문장도 모델에 따라 토큰 수가 다릅니다.";
MERGE (c:Content {id: "content:tool"}) SET c.name = "Tool", c.file = "dict/01_core_architecture.md", c.description = "LLM이 호출할 수 있는 능력 단위. 이름·설명·파라미터 Tool Schema를 선언하고 `execute()`를 구현하면, 모델이 그 설명을 읽고 필요할 때 호출을 요청합니다.";
MERGE (c:Content {id: "content:tool-calling"}) SET c.name = "Tool Calling", c.file = "dict/08_ai_llm_concepts.md", c.description = "LLM이 자연어 대신 구조화된 호출 요청(함수명 + JSON Schema 인자)을 출력하고, 런타임이 실행 후 결과를 되돌려주는 상호작용 규약. 2023년 OpenAI function calling으로 API 표준이 되었습니다. 모델은 실행하지 않고 \"요청\"만 한다는 것이 핵심 — 실행과 그 안전은 전적으로 런타임(nanobot) 몫입니다.";
MERGE (c:Content {id: "content:tool-discovery"}) SET c.name = "Tool Discovery", c.file = "dict/02_tools_and_skills.md", c.description = "`tools/` 패키지를 pkgutil로 스캔해 도구 모듈을 자동 등록하는 메커니즘. \"파일을 그 디렉토리에 두면 도구가 된다\" — 등록 코드를 어디에 추가할지 몰라도 되는 관례 기반 (convention over configuration) 설계입니다. _SKIP_MODULES에 있는 인프라 모듈은 제외되고, 외부 패키지는 Entry-point Plugin으로 합류합니다.";
MERGE (c:Content {id: "content:tool-hint"}) SET c.name = "Tool Hint", c.file = "dict/02_tools_and_skills.md", c.description = "\"지금 어떤 도구가 실행 중인지\"를 UI에 실시간 표시하는 진행 신호. Progress Hook을 타고 WebUI로 전달됩니다 — 긴 턴에서 사용자가 \"멈췄나?\" 하고 불안해하지 않게 하는 UX 장치입니다.";
MERGE (c:Content {id: "content:tool-schema"}) SET c.name = "Tool Schema", c.file = "dict/02_tools_and_skills.md", c.description = "도구 파라미터를 JSON Schema로 선언하기 위한 타입 클래스들 (`StringSchema`, `IntegerSchema`, `ObjectSchema` 등). `to_json_schema()`가 표준 dict를 만들어 Provider에 전달됩니다 — 모델이 읽는 \"도구의 계약서\"를 파이썬답게 쓰는 도우미입니다.";
MERGE (c:Content {id: "content:tool-scope"}) SET c.name = "Tool Scope", c.file = "dict/02_tools_and_skills.md", c.description = "각 도구가 쓰일 수 있는 문맥(`core`, `subagent`)을 제한하는 속성(`_scopes`).";
MERGE (c:Content {id: "content:toolregistry"}) SET c.name = "ToolRegistry", c.file = "dict/02_tools_and_skills.md", c.description = "등록된 모든 Tool의 목록을 관리하고 이름으로 실행을 디스패치하는 중심 객체 — Registry Pattern의 구현입니다. 모델이 `read_file`이라는 이름으로 호출을 요청하면 레지스트리가 해당 도구 객체를 찾아 `execute()`를 부릅니다. MCPToolWrapper처럼 `mcp_` 접두 도구는 내장 도구 뒤로 정렬해 모델이 내장 도구를 우선 보게 합니다.";
MERGE (c:Content {id: "content:toolresult"}) SET c.name = "ToolResult", c.file = "dict/02_tools_and_skills.md", c.description = "도구 실행의 표준 반환 객체(성공 내용 또는 `error`). 핵심 설계는 오류도 삼키지 않고 모델에게 텍스트로 돌려준다는 것 — 모델이 오류 메시지를 읽고 스스로 다른 방법을 시도하게 합니다 (self-correction).";
MERGE (c:Content {id: "content:transcription"}) SET c.name = "Transcription", c.file = "dict/04_providers_and_llm.md", c.description = "음성 메시지를 텍스트로 변환(STT)하는 계층. 음성 채널 메시지가 텍스트 파이프라인에 합류할 수 있게 합니다.";
MERGE (c:Content {id: "content:transformer"}) SET c.name = "Transformer", c.file = "dict/08_ai_llm_concepts.md", c.description = "논문 *Attention Is All You Need*(Vaswani et al., 2017)가 제안한 신경망 구조로, 현대 LLM의 사실상 유일한 토대. 핵심은 Self-Attention — 문장 안의 모든 단어 쌍의 관련도를 병렬로 계산해, 순서대로만 읽던 이전 구조(RNN)의 한계를 넘었습니다. (nanobot은 모델을 API로 쓰므로 트랜스포머를 직접 구현하지 않습니다.)";
MERGE (c:Content {id: "content:transient-error"}) SET c.name = "Transient Error", c.file = "dict/04_providers_and_llm.md", c.description = "시간이 지나면 스스로 해소될 수 있는 오류 — 재시도할 가치가 있는 것들.";
MERGE (c:Content {id: "content:trigger"}) SET c.name = "Trigger", c.file = "dict/06_scheduling_automation.md", c.description = "시간이 아닌 사건으로 에이전트 턴을 시작시키는 확장점. Cron이 \"몇 시에\"라면 트리거는 \"무슨 일이 생기면\"입니다.";
MERGE (c:Content {id: "content:ttl"}) SET c.name = "TTL", c.file = "dict/03_memory_context_session.md", c.description = "데이터나 상태가 \"얼마나 오래 유효한가\"를 정하는 만료 시간. 캐시 만료, DNS 레코드 수명 등에 두루 쓰이는 개념으로, nanobot에서는 세션이 일정 시간 유휴하면 AutoCompact 대상이 되는 기준으로 등장합니다.";
MERGE (c:Content {id: "content:turn"}) SET c.name = "Turn", c.file = "dict/01_core_architecture.md", c.description = "사용자 메시지 하나에 대한 요청-응답 한 사이클. 한 턴 안에서 AgentRunner가 여러 번의 LLM 호출과 Tool 실행을 반복할 수 있습니다 — \"턴 1개 = LLM 호출 N개\"일 수 있다는 점이 단순 챗봇과의 차이입니다.";
MERGE (c:Content {id: "content:turn-continuation"}) SET c.name = "Turn Continuation", c.file = "dict/01_core_architecture.md", c.description = "반복 상한 등으로 중단된 턴을 다음 요청에서 이어서 진행할 수 있게 하는 메커니즘. 긴 작업이 상한에 걸려도 \"처음부터 다시\"가 아니라 \"멈춘 곳부터\"가 가능해집니다.";
MERGE (c:Content {id: "content:turnstate"}) SET c.name = "TurnState", c.file = "dict/01_core_architecture.md", c.description = "한 Turn의 진행 단계를 나타내는 State Machine 국면: RESTORE(이전 상태 복원) → BUILD(컨텍스트 구축) → RUN(러너 실행) → SAVE(저장). 크래시 시 어느 단계까지 갔는지 알 수 있어 Runtime Checkpoint 복구의 기준이 됩니다.";
MERGE (c:Content {id: "content:type-hint"}) SET c.name = "Type Hint", c.file = "dict/09_dev_stack.md", c.description = "파이썬 코드에 변수/인자/반환의 타입을 표기하는 문법(`def f(x: int) -> str:`). 실행에는 영향이 없지만 정적 검사기와 에디터가 오류를 미리 잡게 하고, Pydantic은 이를 런타임 검증 에까지 활용합니다 — nanobot 전반의 안전망입니다.";
MERGE (c:Content {id: "content:typer"}) SET c.name = "Typer", c.file = "dict/09_dev_stack.md", c.description = "Type Hint 기반 CLI 프레임워크 — 함수 시그니처가 곧 명령 인터페이스가 됩니다. `nanobot agent`, `nanobot gateway` 등 CLI(`nanobot/cli/commands.py`)의 뼈대입니다.";
MERGE (c:Content {id: "content:typescript"}) SET c.name = "TypeScript", c.file = "dict/09_dev_stack.md", c.description = "자바스크립트에 정적 타입을 더한 언어 — 파이썬 쪽 Type Hint+Pydantic과 같은 역할을 WebUI에서 합니다.";
MERGE (c:Content {id: "content:unified-session"}) SET c.name = "Unified Session", c.file = "dict/01_core_architecture.md", c.description = "여러 Channel이 하나의 세션 키를 공유해 대화 이력을 이어가는 기능.";
MERGE (c:Content {id: "content:usermd"}) SET c.name = "USER.md", c.file = "dict/03_memory_context_session.md", c.description = "사용자에 대해 알게 된 정보(선호, 습관, 맥락)를 담는 파일.";
MERGE (c:Content {id: "content:vector-database"}) SET c.name = "Vector Database", c.file = "dict/08_ai_llm_concepts.md", c.description = "Embedding 벡터를 저장하고 \"가장 가까운 이웃\"을 빠르게 찾는 특화 DB (Pinecone, Qdrant, pgvector 등). RAG의 저장 계층입니다. nanobot은 이 대신 사람이 읽을 수 있는 마크다운 파일을 기억 저장소로 씁니다 — 투명성을 택한 트레이드오프입니다.";
MERGE (c:Content {id: "content:vite"}) SET c.name = "Vite", c.file = "dict/09_dev_stack.md", c.description = "프런트엔드 빌드 도구 — 개발 서버(HMR)와 프로덕션 번들링을 담당합니다. `webui/vite.config.ts`의 프록시 설정이 개발 중 API/WS 요청을 게이트웨이(:8765)로 넘깁니다.";
MERGE (c:Content {id: "content:voyager"}) SET c.name = "Voyager", c.file = "dict/08_ai_llm_concepts.md", c.description = "*Voyager: An Open-Ended Embodied Agent with LLMs*(Wang et al., 2023) — 마인크래프트에서 에이전트가 스스로 스킬 코드를 작성·저장·재사용하며 성장함을 보인 논문. Skill Library 개념의 대표 실증입니다.";
MERGE (c:Content {id: "content:web-tools"}) SET c.name = "Web Tools", c.file = "dict/02_tools_and_skills.md", c.description = "URL 가져오기(fetch)와 웹 검색 도구. 검색은 ddgs(API 키 불필요)를 쓰고, fetch는 SSRF 방어와 DNS Pinning을 거칩니다 — 에이전트가 인터넷을 읽되 내부망은 못 읽게 하는 경계입니다.";
MERGE (c:Content {id: "content:websocket"}) SET c.name = "WebSocket", c.file = "dict/05_channels_gateway_ui.md", c.description = "HTTP로 시작해 업그레이드되는 양방향 상시 연결 프로토콜(RFC 6455). 요청-응답만 가능한 HTTP와 달리 서버가 먼저 말을 걸 수 있어, 실시간 채팅·알림에 적합합니다.";
MERGE (c:Content {id: "content:websocket-channel"}) SET c.name = "WebSocket Channel", c.file = "dict/05_channels_gateway_ui.md", c.description = "WebUI가 접속하는 WebSocket 기반 채널. 다른 채널과 달리 외부 플랫폼이 아니라 nanobot 자신이 서버가 되며, WebSocket Multiplex Protocol로 대화·이벤트·제어를 한 연결에 싣습니다.";
MERGE (c:Content {id: "content:websocket-multiplex-protocol"}) SET c.name = "WebSocket Multiplex Protocol", c.file = "dict/05_channels_gateway_ui.md", c.description = "하나의 WebSocket 연결 위에 여러 논리 스트림(대화 메시지, 진행 이벤트, 세션 제어)을 태그 붙여 싣는 nanobot의 자체 규약. 연결을 스트림마다 따로 여는 비용을 아낍니다.";
MERGE (c:Content {id: "content:websockets"}) SET c.name = "websockets", c.file = "dict/09_dev_stack.md", c.description = "파이썬 WebSocket 서버/클라이언트 라이브러리 — WebSocket Channel의 구현 재료.";
MERGE (c:Content {id: "content:webui"}) SET c.name = "WebUI", c.file = "dict/05_channels_gateway_ui.md", c.description = "React (JS) + TypeScript + Vite로 만든 SPA 웹 클라이언트. bun으로 빌드해 파이썬 휠에 번들로 포함되므로, 사용자는 Node 없이도 `nanobot gateway` 후 브라우저만 열면 됩니다.";
MERGE (c:Content {id: "content:webui-turn-coordinator"}) SET c.name = "WebUI Turn Coordinator", c.file = "dict/03_memory_context_session.md", c.description = "WebUI에 필요한 턴 이벤트(`_turn_end`, `_goal_status`, 제목 갱신)를 조율하는 계층. `.agent/design.md`에 따라 UI 와이어 세부사항은 코어(AgentLoop)가 아닌 이곳에 둡니다 — 관심사 분리의 사례.";
MERGE (c:Content {id: "content:workspace"}) SET c.name = "Workspace", c.file = "dict/01_core_architecture.md", c.description = "에이전트의 홈 디렉토리. 세션(JSONL), Memory, Skill, Cron Store가 이 아래에 있으며, 파일 도구와 Sandbox의 접근 경계이기도 합니다 — \"에이전트의 집이자 울타리\".";
MERGE (c:Content {id: "content:workspace-access"}) SET c.name = "Workspace Access", c.file = "dict/07_security_isolation.md", c.description = "Workspace Policy의 접근 검사 구현부(경로 정규화, 경계 판정 함수).";
MERGE (c:Content {id: "content:workspace-policy"}) SET c.name = "Workspace Policy", c.file = "dict/07_security_isolation.md", c.description = "파일 접근을 Workspace 경계 안으로 제한하는 정책 계층. `..`나 심볼릭 링크로 경계를 탈출하는 경로 조작을 정규화(resolve) 후 검사로 차단합니다.";
MERGE (c:Content {id: "content:writestdintool"}) SET c.name = "WriteStdinTool", c.file = "dict/02_tools_and_skills.md", c.description = "살아 있는 Exec Session 프로세스의 표준입력에 텍스트/특수키를 쓰는 도구. 대화형 프로그램(REPL, 에디터, 프롬프트) 제어에 쓰입니다.";
MERGE (c:Content {id: "content:zero-shot"}) SET c.name = "Zero-shot", c.file = "dict/08_ai_llm_concepts.md", c.description = "예시 없이 지시만으로 과제를 수행하게 하는 것 — Few-shot Learning의 반대 극단. 현대 LLM은 지시 튜닝 덕에 제로샷 성능이 높아, nanobot의 도구 사용도 대부분 예시 없이 Tool Schema 설명만으로 이뤄집니다.";

